{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"dist/**",
				".output/**"
			],
			"env": [
				"VITE_*"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"dependsOn": [
				"build"
			],
			"cache": false,
			"passThroughEnv": [
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_ACCOUNT_ID"
			]
		},
		"db:push": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:migrate:local": {
			"cache": false
		},
		"db:migrate:remote": {
			"cache": false
		},
		"db:generate": {
			"cache": false,
			"persistent": true
		}
	},
	"globalDependencies": [
		".env",
		".env.*"
	]
}
