{
  "name": "fesflow",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.13.12",
      "better-auth": "^1.4.5",
      "zod": "^4.1.13",
      "dotenv": "^17.2.2",
      "@libsql/client": "^0.14.0",
      "libsql": "^0.5.22"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "dev:api": "turbo -F api dev",
    "dev:app": "turbo -F app dev",
    "dev:visitor": "turbo -F visitor dev",
    "deploy": "turbo deploy",
    "db:generate": "turbo -F @fesflow/db db:generate",
    "db:studio": "turbo -F @fesflow/db db:studio",
    "db:migrate:local": "turbo -F api db:migrate:local",
    "db:migrate:remote": "turbo -F api db:migrate:remote",
    "setup:env": "sh scripts/setup-local-dev.sh --env-only",
    "setup:local": "sh scripts/setup-local-dev.sh",
    "audit:dependencies": "bun scripts/audit-dependencies.ts",
    "test:tooling": "bun test scripts/test"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "@types/node": "^22.13.11"
  },
  "packageManager": "bun@1.3.13",
  "overrides": {
    "dompurify": "3.4.16",
    "source-map-js": "1.2.2",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "browserslist": "4.29.3",
    "baseline-browser-mapping": "2.11.27",
    "next": "16.3.8",
    "undici": "7.30.0",
    "esbuild": "0.25.12"
  }
}
